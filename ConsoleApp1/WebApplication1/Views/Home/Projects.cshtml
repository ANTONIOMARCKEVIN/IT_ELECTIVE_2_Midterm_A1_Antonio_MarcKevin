@{
    ViewData["Title"] = "Projects";
}

<section id="projects" class="bg-white">
    <div class="container">
        <h2 class="display-6 fw-bold text-dark mb-5 text-center">Featured Projects</h2>
        <div class="row g-4">
            <!-- Project 1 -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 portfolio-card">
                    <img src="~/Images/mp1.jfif" class="card-img-top" alt="Periodic Elements" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-truncate">Periodic Elements</h5>
                        <p class="card-text text-muted small">An interactive application showcasing chemical elements, their atomic properties, and periodic trends.</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-dark border">C#</span>
                           
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a href="#" target="_blank" class="btn btn-outline-primary btn-sm w-100">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Project 2 -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 portfolio-card">
                    <img src="~/Images/mp2.jfif" class="card-img-top" alt="Library Book Inventory" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-truncate">Library Book Inventory</h5>
                        <p class="card-text text-muted small">A management system designed to track book availability, student borrowings, and catalog updates.</p>
                        <div class="mt-3">
                            <span class="badge bg-light text-dark border">Java</span>
                            
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a href="#" target="_blank" class="btn btn-outline-primary btn-sm w-100">View Details</a>
                    </div>
                </div>
            </div>

            <!-- Project 3 -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 portfolio-card">
                    <img src="~/Images/mp3.jfif" class="card-img-top" alt="Information Technology-Based Quiz System" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-truncate">IT-Based Quiz System</h5>
                        <p class="card-text text-muted small">A dynamic assessment platform created for testing student knowledge on various Information Technology concepts.</p>
                        <div class="mt-3">
         
                            <span class="badge bg-light text-dark border">Python Laguange</span>
                            
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a href="#" target="_blank" class="btn btn-outline-primary btn-sm w-100">View Details</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>