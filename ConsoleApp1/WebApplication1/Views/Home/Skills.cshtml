
@{
    ViewData["Title"] = "Skills";
}

<section id="skills">
    <div class="container">
        <h2 class="display-6 fw-bold text-dark mb-5 text-center">My Technical Skills</h2>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 portfolio-card">
                    <h5 class="card-title fw-bold text-primary">Programming</h5>
                    <p class="card-text text-muted mt-2">@ViewData["Programming"]</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 portfolio-card">
                    <h5 class="card-title fw-bold text-success">Web Tech</h5>
                    <p class="card-text text-muted mt-2">HTML</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 portfolio-card">
                    <h5 class="card-title fw-bold text-warning">Databases</h5>
                    <p class="card-text text-muted mt-2">MySQL</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 portfolio-card">
                    <h5 class="card-title fw-bold text-danger">Dev Tools</h5>
                    <p class="card-text text-muted mt-2">Git, GitHub, Visual Studio 2022</p>
                </div>
            </div>
        </div>
    </div>
</section>

