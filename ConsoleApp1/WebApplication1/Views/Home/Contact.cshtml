
@{
    ViewData["Title"] = "Contact";
}

<section id="contact">
    <div class="container text-center">
        <h2 class="display-6 fw-bold text-dark mb-4">Connect With Me</h2>
        <p class="lead text-muted mb-5">I am available for technical discussions, team coordination assignments, or entry developer placement roles.</p>

        <div class="row justify-content-center g-4 mb-5">
            <div class="col-md-4">
                <div class="p-3 bg-white shadow-sm rounded">
                    <h6 class="fw-bold text-primary">Email Address</h6>
                    <p class="mb-0 text-muted">@ViewData["Email Address"]</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-white shadow-sm rounded">
                    <h6 class="fw-bold text-primary">Mobile Number</h6>
                    <p class="mb-0 text-muted">@ViewData["Mobile Number"]</p>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3 mb-5">
            <a href="https://github.com/ANTONIOMARCKEVIN" target="_blank" class="btn btn-dark btn-sm px-4">GitHub Profile</a>
            <a href="https://www.linkedin.com/in/marc-antonio-185609422/" target="_blank" class="btn btn-primary btn-sm px-4">LinkedIn Profile</a>
            <a href="https://facebook.com/marczx1" target="_blank" class="btn btn-outline-primary btn-sm px-4">Facebook</a>
        </div>

        <div class="row">
            <div class="col-12">
                <button type="button" class="btn btn-success btn-lg px-5 shadow-sm">Download Resume</button>
            </div>
        </div>
    </div>
</section>


