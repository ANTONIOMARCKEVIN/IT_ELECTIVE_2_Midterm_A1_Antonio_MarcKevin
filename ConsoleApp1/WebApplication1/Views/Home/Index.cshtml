@{
    ViewData["Title"] = "Home Page";
}

<section id="home" class="d-flex align-items-center justify-content-center text-center text-md-start">
    <div class="container">
        <div class="row align-items-center flex-column-reverse flex-md-row">
            <div class="col-md-7">
                <span class="badge bg-primary px-3 py-2 rounded-pill mb-3">Welcome to my Portfolio</span>
                <h1 class="display-4 fw-bold text-dark">Hi, I'm <span class="text-primary">Marc Kevin Antonio</span></h1>
                <h3 class="text-muted fw-semibold mb-4">Information Technology Student</h3>
                <p class="lead text-secondary mb-4">@ViewData["Welcome"]</p>
                
            </div>
            <div class="col-md-5 text-center mb-4 mb-md-0">
                <img src="~/Images/Profpic.jpg" class="img-fluid rounded-circle shadow-lg border border-5 border-white" alt="Marc Kevin Antonio" style="max-width: 280px;" />
            </div>
        </div>
    </div>
</section>