<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>@ViewData["Title"] - MY Personal Resume</title>
		<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
		<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	</head>
	<body>

		<div class="container-fluid">
			<div class="row">
				<nav class="col-md-3 col-lg-2 d-md-block sidebar collapse navbar-dark bg-dark">
					<div class="position-sticky pt-3">
						<div class="text-center text-white mb-4 d-none d-md-block">
							<img src="~/Images/Profpic.jpg" class="rounded-circle mb-2 border border-3 border-primary" alt="Marc Kevin Antonio" style="width: 100px; height: 100px; object-fit: cover;" />
							<h5 class="mb-0">Marc Kevin Antonio</h5>
							<small class="text-muted">Information Technology Student</small>
						</div>

						<ul class="nav flex-column">
							<li class="nav-item">
								<a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-controller="Home" asp-action="About">About Me</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-controller="Home" asp-action="Skills">Skills</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-controller="Home" asp-action="Projects">Project</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
							</li>
						</ul>
					</div>
				</nav>

				<div class="col-12 d-md-none bg-dark text-white p-3 d-flex justify-content-between align-items-center">
					<span class="fw-bold">My Portfolio</span>
					<button class="btn btn-outline-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target=".sidebar">
						Menu
					</button>
				</div>

				<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
					@RenderBody()

					<footer class="text-center py-4 text-muted mt-5">
						<div class="container">
							&copy; 2026 - IT ELECTIVE 2 Midterm
						</div>
					</footer>
				</main>
			</div>
		</div>

		<script src="~/lib/jquery/dist/jquery.min.js"></script>
		<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
		<script src="~/js/site.js" asp-append-version="true"></script>
	</body>
</html>